# Copy to server/.env (gitignored). Never commit real secrets.
NODE_ENV=development
PORT=5000

# MongoDB runs in Docker (see docker-compose.yml). Local dev credentials only.
MONGO_URI=mongodb://kosha:kosha_dev_pw@localhost:27017/kosha?authSource=admin
MONGO_URI_TEST=mongodb://kosha:kosha_dev_pw@localhost:27017/kosha_test?authSource=admin

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Kosha Copilot: Google Gemini API
# Create a free key at https://aistudio.google.com/apikey and paste it below.
# Leave empty to run the copilot in offline mode (built-in rule engine).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
